<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>What to think about at every life stage</title>
  <style>
    :root {
      --ink: #102a43; --navy: #163d59; --teal: #16827a; --mist: #eaf3f4; --gold: #e5ad32;
      --protection: #c94b4b; --liquidity: #b67b00; --accumulation: #16827a;
      --retirement-income: #2f6fb0; --longevity-legacy: #7a4fb5;
      --bar-height: 7.5rem;
    }
    @media (min-width: 720px) { :root { --bar-height: 3.6rem; } }
    * { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body { margin: 0; color: var(--ink); background: #0b1f30; font: 18px/1.45 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    .deck { height: 100vh; height: 100dvh; overflow: hidden; position: relative; }
    .slide { display: none; height: 100%; overflow-y: auto; -webkit-overflow-scrolling: touch; padding: clamp(1.5rem, 6vw, 6rem); padding-bottom: calc(clamp(1.5rem, 6vw, 6rem) + var(--bar-height)); background: #fff; }
    .slide.active { display: flex; flex-direction: column; justify-content: center; }
    .title { color: #fff; background: linear-gradient(135deg, var(--navy), var(--teal)); }
    .eyebrow { color: var(--teal); font-size: .8em; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
    .title .eyebrow { color: #b8ebe5; }
    h1 { font-size: clamp(3rem, 8vw, 7rem); line-height: 1; margin: .25rem 0 1rem; max-width: 18ch; }
    h2 { font-size: clamp(1.8rem, 4.2vw, 3.6rem); line-height: 1.12; margin: .25rem 0 1.25rem; max-width: 24ch; }
    h3 { font-size: 1.15em; margin: 0 0 .6rem; }
    p { max-width: 58rem; margin: .25rem 0 1rem; }
    .quote { color: var(--navy); border-left: .35rem solid var(--gold); font-size: clamp(1.35rem, 2.6vw, 2.2rem); font-weight: 650; max-width: 48rem; padding-left: 1.2rem; }
    .why { color: #334e68; max-width: 48rem; }
    .actions { background: var(--mist); border-radius: 1rem; max-width: 48rem; padding: 1.3rem 1.6rem; }
    .actions h3 { color: var(--navy); }
    .actions ul { margin: 0; padding-left: 1.2rem; }
    .actions li { margin: 0 0 .5rem; }
    .actions li:last-child { margin-bottom: 0; }
    .pillar-tag { border-radius: 99rem; color: #fff; display: inline-block; font-size: .7rem; font-weight: 800; letter-spacing: .06em; margin-bottom: .6rem; padding: .25rem .8rem; text-transform: uppercase; }
{% for pillar in pillars %}
    .pillar-tag.{{ pillar.id }} { background: var(--{{ pillar.id }}); }
{% endfor %}
    .bar { align-items: center; background: rgba(11,31,48,.94); bottom: 0; display: flex; flex-wrap: wrap; gap: .5rem; height: var(--bar-height); left: 0; padding: .5rem 1rem calc(.5rem + env(safe-area-inset-bottom)); position: fixed; right: 0; z-index: 2; }
    .stage-nav { display: flex; flex: 1 1 100%; gap: .5rem; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
    .stage-nav::-webkit-scrollbar { display: none; }
    .stage-nav button { background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.4); border-radius: 99rem; color: #fff; cursor: pointer; flex: none; font: inherit; font-size: .75rem; font-weight: 700; padding: .5rem 1rem; white-space: nowrap; }
    .stage-nav button.current { background: var(--gold); border-color: var(--gold); color: var(--ink); }
    .controls { display: flex; flex: 1 1 100%; gap: .5rem; justify-content: center; }
    .controls button { background: rgba(255,255,255,.16); border: 1px solid rgba(255,255,255,.45); border-radius: 99rem; color: #fff; cursor: pointer; font: inherit; min-height: 2.6rem; min-width: 2.6rem; padding: .5rem .9rem; }
    @media (min-width: 720px) {
      .bar { flex-wrap: nowrap; }
      .stage-nav { flex: 1 1 auto; }
      .controls { flex: none; justify-content: flex-end; margin-left: auto; }
    }
    @media print { body, .deck { background: #fff; height: auto; overflow: visible; } .slide, .slide.active { display: flex; min-height: 100vh; padding-bottom: clamp(1.5rem, 6vw, 6rem); page-break-after: always; } .bar { display: none; } }
  </style>
</head>
<body>
  <main class="deck" aria-label="Financial conversation presentation">
    <section class="slide title active" data-stage="intro">
      <p class="eyebrow">A conversation about your future</p>
      <h1>What to think about, wherever life has you right now.</h1>
      <p>A handful of questions worth sitting with — for yourself and your family — at each stage of life. Use the arrow keys or the controls below to move through them, and jump to any stage at any time.</p>
    </section>
{% for stage in stages %}
    <section class="slide" data-stage="{{ stage.id }}">
      <p class="eyebrow">Life stage</p>
      <h1>{{ stage.name }}</h1>
      <p>{{ stage.description }}</p>
      <p class="quote">“{{ stage.opening_line }}”</p>
    </section>
{% for question in questions_by_stage[stage.id] %}
    <section class="slide" data-stage="{{ stage.id }}">
      <span class="pillar-tag {{ question.pillar }}">{{ pillar_names[question.pillar] }}</span>
      <h2>{{ question.prompt }}</h2>
      <p class="why">{{ question.body }}</p>
      <div class="actions">
        <h3>What you can do about it</h3>
        <ul>
{% for action in question.actions %}
          <li>{{ action }}</li>
{% endfor %}
        </ul>
      </div>
    </section>
{% endfor %}
{% endfor %}
  </main>
  <footer class="bar">
    <nav class="stage-nav" aria-label="Jump to a life stage">
{% for stage in stages %}
      <button type="button" data-jump="{{ stage.id }}">{{ stage.name }}</button>
{% endfor %}
    </nav>
    <div class="controls"><button type="button" id="previous" aria-label="Previous slide">←</button><button type="button" id="next" aria-label="Next slide">→</button></div>
  </footer>
  <script>
    const slides = [...document.querySelectorAll('.slide')];
    const stageButtons = [...document.querySelectorAll('.stage-nav button')];
    let current = 0;
    function show(index) {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => slide.classList.toggle('active', i === current));
      const stage = slides[current].dataset.stage;
      stageButtons.forEach(button => button.classList.toggle('current', button.dataset.jump === stage));
      document.title = `${current + 1}/${slides.length} · What to think about at every life stage`;
    }
    document.getElementById('previous').addEventListener('click', () => show(current - 1));
    document.getElementById('next').addEventListener('click', () => show(current + 1));
    stageButtons.forEach(button => button.addEventListener('click', () => {
      show(slides.findIndex(slide => slide.dataset.stage === button.dataset.jump));
    }));
    document.addEventListener('keydown', event => { if (['ArrowRight', 'PageDown', ' '].includes(event.key)) show(current + 1); if (['ArrowLeft', 'PageUp'].includes(event.key)) show(current - 1); });
  </script>
</body>
</html>
